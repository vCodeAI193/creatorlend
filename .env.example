# --- Allgemein ---
NODE_ENV=development

# --- API ---
API_PORT=4000
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# --- Datenbank (PostgreSQL) ---
DATABASE_URL=postgresql://creatorlend:creatorlend@localhost:5432/creatorlend?schema=public

# --- Redis (Cache / BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Object Storage (S3 / R2) ---
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_REGION=eu-central-1
STORAGE_BUCKET=creatorlend-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
MEDIA_CDN_BASE_URL=https://cdn.example.com

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# --- Domänen-Konfiguration ---
DEFAULT_LOAN_DURATION_DAYS=7
