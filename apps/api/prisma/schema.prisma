// CreatorLend – Prisma-Schema
// Modelliert Nutzer:innen, Werke, Abos, Ausleihen und Vergütung.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LISTENER
  ARTIST
  ADMIN
}

enum WorkType {
  MUSIC
  PODCAST
  AUDIOBOOK
  SKETCH
}

enum WorkStatus {
  DRAFT
  PUBLISHED
}

enum LoanStatus {
  ACTIVE
  EXPIRED
  EXCHANGED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PayoutItemStatus {
  PENDING
  PAID
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(LISTENER)
  displayName  String
  language     String?  // Bevorzugte Sprache (ISO 639-1, z. B. "de")
  bio          String?  // Kurzbiografie für Künstler-Profil (B-013)
  avatarUrl    String?  // Profilbild-URL (B-013, B-014)
  slug         String?  @unique // individuelle Profil-URL (B-017)
  socialLinks  Json?    // externe Links { website, twitter, instagram, ... } (B-016)
  emailVerified Boolean @default(false)
  stripeConnectAccountId String? // Stripe-Connect-Konto für Auszahlungen
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  works         Work[]         @relation("ArtistWorks")
  loans         Loan[]
  subscription  Subscription?
  payoutItems   PayoutItem[]   @relation("ArtistPayouts")
  favorites     Favorite[]
  following      Follow[]       @relation("Following")
  followers      Follow[]       @relation("Followers")
  notifications Notification[]
  refreshTokens           RefreshToken[]
  authTokens              AuthToken[]
  notificationPreferences NotificationPreference[]
  wishlist                Wishlist[]
  ratingsGiven  Rating[]       @relation("RaterRatings")
  reviews       Review[]       @relation("ReviewerReviews")
  auditLogs     AuditLog[]
  playlists         Playlist[]
  reports           Report[]           @relation("UserReports")
  subscriptionEvents SubscriptionEvent[]
  unsubscribeTokens UnsubscribeToken[]
}

// Rotierende Refresh-Tokens (B-001). Klartext wird nie gespeichert.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  family    String // Token-Familie für Reuse-Erkennung
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
}

// Einmal-Tokens für E-Mail-Verifizierung (B-002) und Passwort-Reset (B-003).
model AuthToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model Work {
  id              String     @id @default(uuid())
  artistId        String
  artist          User       @relation("ArtistWorks", fields: [artistId], references: [id])
  title           String
  type            WorkType
  description     String?
  loanPriceCents  Int
  loanDays        Int        @default(7)  // Konfigurierbare Leihdauer (B-077)
  durationSeconds Int?
  language        String?
  category        String?
  tags            String[]   @default([]) // Schlagworte (B-036)
  explicit        Boolean    @default(false) // Explicit-Content-Kennzeichnung (B-038)
  borrowCount     Int        @default(0)
  mediaKey        String? // Schlüssel im Object Storage
  previewKey      String? // Vorschau-/Trailer-Datei (kostenlos hörbar, B-043)
  coverKey        String? // Cover-Bild-Schlüssel im Object Storage (B-056)
  publishAt       DateTime?  // Geplante Veröffentlichung (B-040)
  status          WorkStatus @default(DRAFT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  loans         Loan[]
  favorites     Favorite[]
  wishlists     Wishlist[]
  episodes      Episode[]      // mehrteilige Werke (B-033)
  chapterMarks  ChapterMark[]  // Kapitelmarken (B-034)
  ratings       Rating[]
  reviews       Review[]
  playlistItems PlaylistItem[]

  @@index([artistId])
  @@index([type, status])
  @@index([status, borrowCount])
  @@index([status, publishAt])    // B-040: geplante Veröffentlichung
  @@index([status, createdAt])    // B-196: Discovery-Sort
  @@index([status, loanPriceCents]) // B-196: Preis-Facette
}

// Episoden/Kapitel für mehrteilige Werke (B-033)
model Episode {
  id              String   @id @default(uuid())
  workId          String
  work            Work     @relation(fields: [workId], references: [id])
  number          Int      // Reihenfolge innerhalb des Werks (1-basiert)
  title           String
  description     String?
  durationSeconds Int?
  mediaKey        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([workId, number])
  @@index([workId])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id])
  plan                 String
  status               SubscriptionStatus @default(ACTIVE)
  loanQuotaPerPeriod   Int
  loansUsedThisPeriod  Int                @default(0)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?          // Testzeitraum-Ende (B-086)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Loan {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  workId       String
  work         Work       @relation(fields: [workId], references: [id])
  status       LoanStatus @default(ACTIVE)
  startedAt    DateTime   @default(now())
  expiresAt    DateTime
  renewalCount Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  payoutItems      PayoutItem[]
  playbackProgress PlaybackProgress?

  @@index([userId, status])
  @@index([status, expiresAt])
}

model PayoutItem {
  id          String           @id @default(uuid())
  artistId    String
  artist      User             @relation("ArtistPayouts", fields: [artistId], references: [id])
  loanId      String
  loan        Loan             @relation(fields: [loanId], references: [id])
  amountCents Int
  status      PayoutItemStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@index([artistId, status])
}

// Merkliste / Favoriten der Hörer:innen (F-016)
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, workId])
  @@index([userId])
}

// Folgen von Künstler:innen (F-017)
model Follow {
  id         String   @id @default(uuid())
  followerId String
  follower   User     @relation("Following", fields: [followerId], references: [id])
  artistId   String
  artist     User     @relation("Followers", fields: [artistId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([followerId, artistId])
  @@index([artistId])
}

// In-App-Benachrichtigungen (F-082..F-084)
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// Benachrichtigungspräferenzen je Typ (B-028)
model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

// Abspielposition je Leihe – Fortschritt speichern/fortsetzen (B-073)
model PlaybackProgress {
  id              String   @id @default(uuid())
  loanId          String   @unique
  loan            Loan     @relation(fields: [loanId], references: [id])
  positionSeconds Int      @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// Stripe-Webhook-Events zur Deduplizierung (B-112)
model StripeWebhookEvent {
  id          String   @id // Stripe Event-ID (evt_...)
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// Wunschliste / „Später leihen" (B-031)
model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, workId])
  @@index([userId])
}

// Kapitelmarken und Sprungnavigation (B-034)
model ChapterMark {
  id              String    @id @default(uuid())
  workId          String
  work            Work      @relation(fields: [workId], references: [id])
  episodeId       String?   // optional: Kapitelmarke innerhalb einer Episode
  title           String
  positionSeconds Int
  createdAt       DateTime  @default(now())

  @@index([workId])
  @@index([episodeId])
}

// Sternebewertungen für Werke (B-129)
model Rating {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("RaterRatings", fields: [userId], references: [id])
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  value     Int      // 1–5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workId])
  @@index([workId])
}

// Textrezensionen für Werke (B-130)
model Review {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation("ReviewerReviews", fields: [userId], references: [id])
  workId    String
  work      Work      @relation(fields: [workId], references: [id])
  body      String
  hidden    Boolean   @default(false) // moderiert (B-131)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, workId])
  @@index([workId])
}

// Audit-Log für Admin-Aktionen (B-155)
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String   // z. B. SUSPEND_USER, MODERATE_WORK
  targetType String?  // "User" | "Work"
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// Promo-Codes / Gutscheine (B-087)
model PromoCode {
  id              String   @id @default(uuid())
  code            String   @unique
  discountPercent Int?
  discountCents   Int?
  plan            String?
  maxUses         Int?
  usesCount       Int      @default(0)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(uuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  userId      String
  redeemedAt  DateTime  @default(now())

  @@unique([promoCodeId, userId])
  @@index([promoCodeId])
  @@index([userId])
}

// Öffentliche Playlisten / Sammlungen (B-133)
model Playlist {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PlaylistItem[]

  @@index([userId])
  @@index([isPublic])
}

model PlaylistItem {
  id         String   @id @default(uuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  workId     String
  work       Work     @relation(fields: [workId], references: [id])
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  @@unique([playlistId, workId])
  @@index([playlistId])
}

// Inhaltsmeldungen (B-139, B-153)
model Report {
  id          String   @id @default(uuid())
  reporterId  String
  reporter    User     @relation("UserReports", fields: [reporterId], references: [id])
  targetType  String
  targetId    String
  reason      String
  description String?
  status      String   @default("OPEN")
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
}

// Abo-Ereignis-Log / Abrechnungshistorie (B-090)
model SubscriptionEvent {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  event       String
  plan        String?
  amountCents Int?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Abmelde-Token für E-Mail-Benachrichtigungen (B-125)
model UnsubscribeToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique @default(uuid())
  type      String?
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}
