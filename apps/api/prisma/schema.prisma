// CreatorLend – Prisma-Schema
// Modelliert Nutzer:innen, Werke, Abos, Ausleihen und Vergütung.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LISTENER
  ARTIST
}

enum WorkType {
  MUSIC
  PODCAST
  AUDIOBOOK
  SKETCH
}

enum WorkStatus {
  DRAFT
  PUBLISHED
}

enum LoanStatus {
  ACTIVE
  EXPIRED
  EXCHANGED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PayoutItemStatus {
  PENDING
  PAID
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(LISTENER)
  displayName  String
  stripeConnectAccountId String? // Stripe-Connect-Konto für Auszahlungen
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  works         Work[]         @relation("ArtistWorks")
  loans         Loan[]
  subscription  Subscription?
  payoutItems   PayoutItem[]   @relation("ArtistPayouts")
  favorites     Favorite[]
  following      Follow[]       @relation("Following")
  followers      Follow[]       @relation("Followers")
  notifications Notification[]
}

model Work {
  id              String     @id @default(uuid())
  artistId        String
  artist          User       @relation("ArtistWorks", fields: [artistId], references: [id])
  title           String
  type            WorkType
  description     String?
  loanPriceCents  Int
  durationSeconds Int?
  language        String?
  category        String?
  borrowCount     Int        @default(0)
  mediaKey        String? // Schlüssel im Object Storage
  status          WorkStatus @default(DRAFT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  loans     Loan[]
  favorites Favorite[]

  @@index([artistId])
  @@index([type, status])
  @@index([status, borrowCount])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id])
  plan                 String
  status               SubscriptionStatus @default(ACTIVE)
  loanQuotaPerPeriod   Int
  loansUsedThisPeriod  Int                @default(0)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Loan {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  workId       String
  work         Work       @relation(fields: [workId], references: [id])
  status       LoanStatus @default(ACTIVE)
  startedAt    DateTime   @default(now())
  expiresAt    DateTime
  renewalCount Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  payoutItems PayoutItem[]

  @@index([userId, status])
  @@index([status, expiresAt])
}

model PayoutItem {
  id          String           @id @default(uuid())
  artistId    String
  artist      User             @relation("ArtistPayouts", fields: [artistId], references: [id])
  loanId      String
  loan        Loan             @relation(fields: [loanId], references: [id])
  amountCents Int
  status      PayoutItemStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@index([artistId, status])
}

// Merkliste / Favoriten der Hörer:innen (F-016)
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, workId])
  @@index([userId])
}

// Folgen von Künstler:innen (F-017)
model Follow {
  id         String   @id @default(uuid())
  followerId String
  follower   User     @relation("Following", fields: [followerId], references: [id])
  artistId   String
  artist     User     @relation("Followers", fields: [artistId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([followerId, artistId])
  @@index([artistId])
}

// In-App-Benachrichtigungen (F-082..F-084)
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}
