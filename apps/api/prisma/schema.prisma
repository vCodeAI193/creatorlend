// CreatorLend – Prisma-Schema
// Modelliert Nutzer:innen, Werke, Abos, Ausleihen und Vergütung.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LISTENER
  ARTIST
}

enum WorkType {
  MUSIC
  PODCAST
  AUDIOBOOK
  SKETCH
}

enum WorkStatus {
  DRAFT
  PUBLISHED
}

enum LoanStatus {
  ACTIVE
  EXPIRED
  EXCHANGED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PayoutItemStatus {
  PENDING
  PAID
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(LISTENER)
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  works        Work[]        @relation("ArtistWorks")
  loans        Loan[]
  subscription Subscription?
  payoutItems  PayoutItem[]  @relation("ArtistPayouts")
}

model Work {
  id              String     @id @default(uuid())
  artistId        String
  artist          User       @relation("ArtistWorks", fields: [artistId], references: [id])
  title           String
  type            WorkType
  description     String?
  loanPriceCents  Int
  durationSeconds Int?
  language        String?
  mediaKey        String? // Schlüssel im Object Storage
  status          WorkStatus @default(DRAFT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  loans Loan[]

  @@index([artistId])
  @@index([type, status])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id])
  plan                 String
  status               SubscriptionStatus @default(ACTIVE)
  loanQuotaPerPeriod   Int
  loansUsedThisPeriod  Int                @default(0)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Loan {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  workId       String
  work         Work       @relation(fields: [workId], references: [id])
  status       LoanStatus @default(ACTIVE)
  startedAt    DateTime   @default(now())
  expiresAt    DateTime
  renewalCount Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  payoutItems PayoutItem[]

  @@index([userId, status])
  @@index([status, expiresAt])
}

model PayoutItem {
  id          String           @id @default(uuid())
  artistId    String
  artist      User             @relation("ArtistPayouts", fields: [artistId], references: [id])
  loanId      String
  loan        Loan             @relation(fields: [loanId], references: [id])
  amountCents Int
  status      PayoutItemStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@index([artistId, status])
}
