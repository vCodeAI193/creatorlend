// CreatorLend – Prisma-Schema
// Modelliert Nutzer:innen, Werke, Abos, Ausleihen und Vergütung.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LISTENER
  ARTIST
  ADMIN
}

enum WorkType {
  MUSIC
  PODCAST
  AUDIOBOOK
  SKETCH
}

enum WorkStatus {
  DRAFT
  PUBLISHED
}

enum LoanStatus {
  ACTIVE
  EXPIRED
  EXCHANGED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PayoutItemStatus {
  PENDING
  PAID
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(LISTENER)
  displayName  String
  language     String?  // Bevorzugte Sprache (ISO 639-1, z. B. "de")
  bio          String?  // Kurzbiografie für Künstler-Profil (B-013)
  avatarUrl    String?  // Profilbild-URL (B-013, B-014)
  slug         String?  @unique // individuelle Profil-URL (B-017)
  socialLinks  Json?    // externe Links { website, twitter, instagram, ... } (B-016)
  interestTags String[] @default([]) // Interesse-Tags (F-535)
  emailVerified Boolean @default(false)
  stripeConnectAccountId String? // Stripe-Connect-Konto für Auszahlungen
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  loginAttempts   Int       @default(0)
  lockedUntil     DateTime?              // Account-Sperre nach Fehlversuchen (F-012)
  deletedAt       DateTime?              // Soft-Delete (F-024)
  termsVersion    String?                // Akzeptierte AGB-Version (F-047)
  termsAcceptedAt DateTime?              // Zeitpunkt der Zustimmung
  analyticsOptOut Boolean   @default(false) // Analytics-Opt-out (F-076)
  referralCode    String?    @unique // Einladungscode (F-063)
  referredById    String?    // Wer hat eingeladen?
  notifDigestMode String?    // Benachrichtigungsdigest-Modus (F-642)
  quietHoursStart Int?       // Stille Stunden: Beginn (0-23) (F-643)
  quietHoursEnd   Int?       // Stille Stunden: Ende (0-23) (F-643)
  totpSecret      String?                // 2FA TOTP secret (F-005)
  totpEnabled     Boolean   @default(false) // 2FA aktiv (F-005)
  backupCodes     String[]  @default([]) // gehashte Backup-Codes (F-007)
  wishlistPublic  Boolean   @default(false) // Öffentliche Wunschliste (F-241)
  wishlistSlug    String?   @unique         // Slug für öffentliche Wunschliste (F-241)
  preferredTypes      String[] @default([]) // Bevorzugte Inhaltstypen (F-073)
  preferredLanguages  String[] @default([]) // Bevorzugte Sprachen (F-074)
  excludedLanguages   String[] @default([]) // Ausgeschlossene Sprachen (F-074)
  profileVisibility   String   @default("PUBLIC") // PUBLIC | FOLLOWERS_ONLY | PRIVATE (F-059)
  birthYear           Int?                             // Geburtsjahr für Altersverifikation (F-041)
  isMinor             Boolean  @default(false)         // < 18 Jahre (F-041)
  ageVerifiedAt       DateTime?                        // Zeitpunkt der Altersverifikation
  parentalConsent     Boolean  @default(false)         // Elterliche Zustimmung (F-041)
  kidsModeEnabled     Boolean  @default(false)         // Kinder-Modus (F-042)
  trackingOptOut      Boolean  @default(false)         // Tracking opt-out (F-076)
  profilingOptOut     Boolean  @default(false)         // Profiling-Widerspruch (F-080)
  doNotTrack          Boolean  @default(false)         // Do Not Track (F-078)
  currency            String   @default("EUR")         // Bevorzugte Währung (F-306)
  payoutThreshold     Int      @default(1000)          // Mindestauszahlungsbetrag in Cents (F-310)
  suspendedAt         DateTime?                        // Suspension timestamp (F-384)
  suspendReason       String?                          // Suspension reason (F-384)
  fcmToken            String?                          // FCM push notification token (F-402)
  failedLoginAttempts   Int       @default(0)      // F-012
  deletionRequestedAt   DateTime?                   // F-024
  isDeactivated         Boolean   @default(false)   // F-025
  ageVerified           Boolean   @default(false)   // F-115

  works         Work[]         @relation("ArtistWorks")
  loans         Loan[]
  subscription  Subscription?
  payoutItems   PayoutItem[]   @relation("ArtistPayouts")
  favorites     Favorite[]
  following      Follow[]       @relation("Following")
  followers      Follow[]       @relation("Followers")
  notifications Notification[]
  refreshTokens           RefreshToken[]
  authTokens              AuthToken[]
  notificationPreferences NotificationPreference[]
  wishlist                Wishlist[]
  ratingsGiven  Rating[]       @relation("RaterRatings")
  reviews       Review[]       @relation("ReviewerReviews")
  auditLogs     AuditLog[]
  playlists         Playlist[]
  reports           Report[]           @relation("UserReports")
  subscriptionEvents SubscriptionEvent[]
  unsubscribeTokens UnsubscribeToken[]
  emailChangeRequests EmailChangeRequest[]
  savedSearches SavedSearch[]
  series              Series[]           @relation("ArtistSeries")
  artistPosts         ArtistPost[]       @relation("ArtistPosts")
  postComments        ArtistPostComment[] @relation("PostComments")
  sentMessages        DirectMessage[]    @relation("SentMessages")
  receivedMessages    DirectMessage[]    @relation("ReceivedMessages")
  blocking            Block[]            @relation("Blocking")
  blockedBy           Block[]            @relation("Blocked")
  sentTips            Tip[]              @relation("SentTips")
  receivedTips        Tip[]              @relation("ReceivedTips")
  milestones          Milestone[]
  inviteCodes         InviteCode[]
  userBadges          UserBadge[]
  bookmarks           Bookmark[]
  workNotes           WorkNote[]
  adminNotes          AdminNote[]
  authoredNotes       AdminNote[]        @relation("AuthoredNotes")
  oauthAccounts       OAuthAccount[]
  magicLinks          MagicLink[]
  apiKeys             ApiKey[]
  sentGiftCodes       GiftCode[]         @relation("SentGiftCodes")
  receivedGiftCodes   GiftCode[]         @relation("ReceivedGiftCodes")
  singleLoanPurchases SingleLoanPurchase[]
  loanAddons          LoanAddon[]
  sentLoanGifts       LoanGift[]         @relation("SentLoanGifts")
  receivedLoanGifts   LoanGift[]         @relation("ReceivedLoanGifts")
  loanReservations    LoanReservation[]
  studentVerification StudentVerification?
  consentRecords      ConsentRecord[]
  abTests             AbTestAssignment[]
  searchHistory         SearchHistory[]
  highContrast          Boolean   @default(false)
  fontSize              String    @default("MEDIUM")
  reducedMotion         Boolean   @default(false)
  faqs                  ArtistFaq[]
  collections           Collection[]
  webhookSubscriptions  WebhookSubscription[]
  billingAddress        BillingAddress?       // F-341
  discountCodes         DiscountCode[]        @relation("ArtistDiscountCodes") // F-383
  readingChallenge      ReadingChallenge?     // F-550
  userSessions      UserSession[]
  loginHistory      LoginHistory[]
  passwordHistory   PasswordHistory[]
  playbackPositions PlaybackPosition[]
}

// Rotierende Refresh-Tokens (B-001). Klartext wird nie gespeichert.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  family    String // Token-Familie für Reuse-Erkennung
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
}

// Einmal-Tokens für E-Mail-Verifizierung (B-002) und Passwort-Reset (B-003).
model AuthToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model Work {
  id              String     @id @default(uuid())
  artistId        String
  artist          User       @relation("ArtistWorks", fields: [artistId], references: [id])
  title           String
  type            WorkType
  description     String?
  loanPriceCents  Int
  loanDays        Int        @default(7)  // Konfigurierbare Leihdauer (B-077)
  durationSeconds Int?
  language        String?
  category        String?
  tags            String[]   @default([]) // Schlagworte (B-036)
  explicit        Boolean    @default(false) // Explicit-Content-Kennzeichnung (B-038)
  borrowCount     Int        @default(0)
  mediaKey        String? // Schlüssel im Object Storage
  previewKey      String? // Vorschau-/Trailer-Datei (kostenlos hörbar, B-043)
  coverKey        String? // Cover-Bild-Schlüssel im Object Storage (B-056)
  publishAt       DateTime?  // Geplante Veröffentlichung (B-040)
  archivedAt      DateTime?  // Archiviert (F-097)
  deletedAt       DateTime?  // Soft-Delete (F-098)
  licenseType     String?    // z. B. "CC_BY", "ALL_RIGHTS_RESERVED" (F-111)
  embargoUntil    DateTime?  // Veröffentlichungs-Embargo bis (F-113)
  geoBlock        String[]   @default([]) // gesperrte Länder ISO 3166-1 alpha-2 (F-114)
  ageRating       String?    // "FSK_0" | "FSK_6" | "FSK_12" | "FSK_16" | "FSK_18" (F-115)
  contentWarnings String[]   @default([]) // Content-Warnungen (F-116)
  isExclusive     Boolean    @default(false) // Exklusiv-Inhalt (F-116)
  earlyAccessDays Int        @default(0)    // Früher Zugang für PREMIUM (F-165/F-166)
  isbn            String?    // ISBN für Audiobücher (F-116)
  isrc            String?    // ISRC für Musik (F-116)
  promoPrice      Int?       // Rabattpreis während Promo (F-455)
  promoEndsAt     DateTime?  // Promo-Ablauf (F-455)
  viewCount       Int        @default(0) // Seitenaufrufe (F-458)
  earningsGoalCents Int?     // Einnahmenziel in Cents (F-460)
  coAuthorIds     String[]   @default([]) // Mitautor-IDs (F-472)
  status          WorkStatus @default(DRAFT)
  availableFrom DateTime?  // F-113: availability window start
  availableTo   DateTime?  // F-113: availability window end
  isFeatured    Boolean    @default(false) // F-133: Featured work
  featuredAt    DateTime?  // F-133: When featured
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  loans               Loan[]
  favorites           Favorite[]
  wishlists           Wishlist[]
  singleLoanPurchases SingleLoanPurchase[]
  episodes            Episode[]      // mehrteilige Werke (B-033)
  chapterMarks        ChapterMark[]  // Kapitelmarken (B-034)
  ratings             Rating[]
  reviews             Review[]
  playlistItems       PlaylistItem[]
  seriesItems         SeriesItem[]
  transcripts         Transcript[]
  workVersions        WorkVersion[]
  bookmarks           Bookmark[]
  workNotes           WorkNote[]
  dmcaTakedowns       DmcaTakedown[]
  loanGifts           LoanGift[]
  loanReservations    LoanReservation[]
  subtitleTracks      SubtitleTrack[]
  lyrics              Lyrics?
  translations        WorkTranslation[]
  hasTranscript       Boolean         @default(false)
  hasAudioDescription Boolean         @default(false)
  hasCaptions         Boolean         @default(false)
  collectionItems     CollectionItem[]
  playbackPositions PlaybackPosition[]
  categories      WorkCategoryAssignment[]   // F-146/F-147

  @@index([artistId])
  @@index([type, status])
  @@index([status, borrowCount])
  @@index([status, publishAt])    // B-040: geplante Veröffentlichung
  @@index([status, createdAt])    // B-196: Discovery-Sort
  @@index([status, loanPriceCents]) // B-196: Preis-Facette
}

// Episoden/Kapitel für mehrteilige Werke (B-033)
model Episode {
  id              String   @id @default(uuid())
  workId          String
  work            Work     @relation(fields: [workId], references: [id])
  number          Int      // Reihenfolge innerhalb des Werks (1-basiert)
  title           String
  description     String?
  durationSeconds Int?
  mediaKey        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([workId, number])
  @@index([workId])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id])
  plan                 String
  status               SubscriptionStatus @default(ACTIVE)
  loanQuotaPerPeriod   Int
  loansUsedThisPeriod  Int                @default(0)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?          // Testzeitraum-Ende (B-086)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Loan {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  workId       String
  work         Work       @relation(fields: [workId], references: [id])
  status       LoanStatus @default(ACTIVE)
  startedAt    DateTime   @default(now())
  expiresAt    DateTime
  renewalCount Int        @default(0)
  pausedAt     DateTime?  // Urlaubsmodus: Pausiert seit (F-267)
  pausedUntil  DateTime?  // Urlaubsmodus: Pausiert bis (F-267)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  payoutItems      PayoutItem[]
  playbackProgress PlaybackProgress?
  devices          LoanDevice[]
  downloadTokens   DownloadToken[]

  @@index([userId, status])
  @@index([status, expiresAt])
}

model PayoutItem {
  id          String           @id @default(uuid())
  artistId    String
  artist      User             @relation("ArtistPayouts", fields: [artistId], references: [id])
  loanId      String
  loan        Loan             @relation(fields: [loanId], references: [id])
  amountCents Int
  status      PayoutItemStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@index([artistId, status])
}

// Merkliste / Favoriten der Hörer:innen (F-016)
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, workId])
  @@index([userId])
}

// Folgen von Künstler:innen (F-017)
model Follow {
  id         String   @id @default(uuid())
  followerId String
  follower   User     @relation("Following", fields: [followerId], references: [id])
  artistId   String
  artist     User     @relation("Followers", fields: [artistId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([followerId, artistId])
  @@index([artistId])
}

// In-App-Benachrichtigungen (F-082..F-084)
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// Benachrichtigungspräferenzen je Typ (B-028)
model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

// Abspielposition je Leihe – Fortschritt speichern/fortsetzen (B-073)
model PlaybackProgress {
  id              String   @id @default(uuid())
  loanId          String   @unique
  loan            Loan     @relation(fields: [loanId], references: [id])
  positionSeconds Int      @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// Stripe-Webhook-Events zur Deduplizierung (B-112)
model StripeWebhookEvent {
  id          String   @id // Stripe Event-ID (evt_...)
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// Wunschliste / „Später leihen" (B-031)
model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, workId])
  @@index([userId])
}

// Kapitelmarken und Sprungnavigation (B-034)
model ChapterMark {
  id              String    @id @default(uuid())
  workId          String
  work            Work      @relation(fields: [workId], references: [id])
  episodeId       String?   // optional: Kapitelmarke innerhalb einer Episode
  title           String
  positionSeconds Int
  createdAt       DateTime  @default(now())

  @@index([workId])
  @@index([episodeId])
}

// Sternebewertungen für Werke (B-129)
model Rating {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("RaterRatings", fields: [userId], references: [id])
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  value     Int      // 1–5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workId])
  @@index([workId])
}

// Textrezensionen für Werke (B-130)
model Review {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation("ReviewerReviews", fields: [userId], references: [id])
  workId          String
  work            Work        @relation(fields: [workId], references: [id])
  body            String
  rating          Int?        // 1-5 Sterne (F-529/F-530)
  hidden          Boolean     @default(false) // moderiert (B-131)
  isVerifiedBuyer Boolean     @default(false) // F-524: verifizierter Käufer
  artistReply     String?
  artistRepliedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  votes           ReviewVote[]

  @@unique([userId, workId])
  @@index([workId])
  @@index([workId, createdAt])
  @@index([workId, rating])
}

// Audit-Log für Admin-Aktionen (B-155)
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String   // z. B. SUSPEND_USER, MODERATE_WORK
  targetType String?  // "User" | "Work"
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// Promo-Codes / Gutscheine (B-087)
model PromoCode {
  id              String   @id @default(uuid())
  code            String   @unique
  discountPercent Int?
  discountCents   Int?
  plan            String?
  maxUses         Int?
  usesCount       Int      @default(0)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(uuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  userId      String
  redeemedAt  DateTime  @default(now())

  @@unique([promoCodeId, userId])
  @@index([promoCodeId])
  @@index([userId])
}

// Öffentliche Playlisten / Sammlungen (B-133)
model Playlist {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PlaylistItem[]

  @@index([userId])
  @@index([isPublic])
}

model PlaylistItem {
  id         String   @id @default(uuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  workId     String
  work       Work     @relation(fields: [workId], references: [id])
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  @@unique([playlistId, workId])
  @@index([playlistId])
}

// Inhaltsmeldungen (B-139, B-153)
model Report {
  id          String   @id @default(uuid())
  reporterId  String
  reporter    User     @relation("UserReports", fields: [reporterId], references: [id])
  targetType  String
  targetId    String
  reason      String
  description String?
  status      String   @default("OPEN")
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
}

// Abo-Ereignis-Log / Abrechnungshistorie (B-090)
model SubscriptionEvent {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  event       String
  plan        String?
  amountCents Int?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Abmelde-Token für E-Mail-Benachrichtigungen (B-125)
model UnsubscribeToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique @default(uuid())
  type      String?
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// E-Mail-Änderungsanfragen mit Verifizierung (F-020)
model EmailChangeRequest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  newEmail    String
  tokenHash   String    @unique
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// Gespeicherte Suchanfragen (F-199)
model SavedSearch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  query     Json     // serialisierter Suchfilter
  notify    Boolean  @default(false) // E-Mail bei neuen Treffern
  createdAt DateTime @default(now())

  @@index([userId])
}

// Serien für mehrteilige Werke (F-117)
model Series {
  id          String   @id @default(uuid())
  artistId    String
  artist      User     @relation("ArtistSeries", fields: [artistId], references: [id])
  title       String
  description String?
  coverKey    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  works SeriesItem[]

  @@index([artistId])
}

model SeriesItem {
  id        String   @id @default(uuid())
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  position  Int      @default(0)

  @@unique([seriesId, workId])
  @@index([seriesId])
}

// Transkripte für Werke (F-103)
model Transcript {
  id        String   @id @default(uuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  language  String   @default("de")
  format    String   @default("TXT") // TXT | SRT | VTT
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workId, language])
  @@index([workId])
}

// Künstler:innen-Beiträge / Ankündigungen (F-446)
model ArtistPost {
  id          String    @id @default(uuid())
  artistId    String
  artist      User      @relation("ArtistPosts", fields: [artistId], references: [id])
  title       String
  body        String
  imageUrl    String?
  linkUrl     String?
  publishedAt DateTime?
  scheduledAt DateTime?
  isPinned    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reactions ArtistPostReaction[]
  comments  ArtistPostComment[]

  @@index([artistId])
  @@index([publishedAt])
}

model ArtistPostReaction {
  id        String     @id @default(uuid())
  postId    String
  post      ArtistPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String     @default("👍")
  createdAt DateTime   @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model ArtistPostComment {
  id        String     @id @default(uuid())
  postId    String
  post      ArtistPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("PostComments", fields: [userId], references: [id])
  body      String
  hidden    Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([postId])
}

// Direktnachrichten (F-580)
model DirectMessage {
  id             String    @id @default(uuid())
  senderId       String
  sender         User      @relation("SentMessages", fields: [senderId], references: [id])
  recipientId    String
  recipient      User      @relation("ReceivedMessages", fields: [recipientId], references: [id])
  body           String
  encryptedBody  String?   // ECDH-verschlüsselter Inhalt (F-940)
  metadata       Json?     // z. B. { type: "WORK_RECOMMENDATION", workId } (F-233)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([senderId, recipientId])
  @@index([recipientId])
}

// Nutzer:innen blockieren (F-577)
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("Blocking", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

// Work-Versionen (F-095)
model WorkVersion {
  id        String   @id @default(uuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  mediaKey  String
  note      String?
  createdAt DateTime @default(now())

  @@index([workId])
}

// Lesezeichen (F-124)
model Bookmark {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  workId          String
  work            Work     @relation(fields: [workId], references: [id])
  positionSeconds Int
  label           String?
  createdAt       DateTime @default(now())

  @@index([userId, workId])
}

// Persönliche Notizen zu Werken (F-126)
model WorkNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workId])
  @@index([userId])
}

// Einladungscodes (F-062)
model InviteCode {
  id         String    @id @default(uuid())
  creatorId  String
  creator    User      @relation(fields: [creatorId], references: [id])
  code       String    @unique @default(uuid())
  maxUses    Int       @default(1)
  usesCount  Int       @default(0)
  bonusLoans Int       @default(0)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([creatorId])
}

// Meilensteine / Gamification (F-064)
model Milestone {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  reachedAt DateTime @default(now())

  @@unique([userId, type])
  @@index([userId])
}

// Badges / Abzeichen (F-065)
model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  awardedAt DateTime @default(now())

  @@unique([userId, type])
  @@index([userId])
}

// Admin-Notizen zu Nutzern (B-155)
model AdminNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  authorId  String
  author    User     @relation("AuthoredNotes", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Abo-Pausierung (F-307)
model SubscriptionPause {
  id        String    @id @default(uuid())
  userId    String    @unique
  pausedAt  DateTime  @default(now())
  resumeAt  DateTime
  resumedAt DateTime?

  @@index([resumeAt])
}

// Trinkgeld / Micropayment (F-323)
model Tip {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("SentTips", fields: [senderId], references: [id])
  artistId    String
  artist      User     @relation("ReceivedTips", fields: [artistId], references: [id])
  workId      String?
  amountCents Int
  message     String?
  createdAt   DateTime @default(now())

  @@index([senderId])
  @@index([artistId])
}

// OAuth-Verknüpfungen (F-002/F-003)
model OAuthAccount {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String   // "google" | "apple"
  providerId String
  email      String?
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

// Magic-Links für passwortloses Login (F-014)
model MagicLink {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @default(uuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// API-Keys für Nutzer:innen (F-031)
model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Geschenk-Codes / Gift Loans (F-239/F-240)
model GiftCode {
  id             String    @id @default(uuid())
  code           String    @unique @default(uuid())
  senderId       String
  sender         User      @relation("SentGiftCodes", fields: [senderId], references: [id])
  recipientEmail String?
  recipientId    String?
  recipient      User?     @relation("ReceivedGiftCodes", fields: [recipientId], references: [id])
  planId         String    // "STANDARD" | "PREMIUM"
  durationDays   Int       @default(30)
  redeemedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@index([code])
}

// DMCA-Takedown-Workflow (F-730)
model DmcaTakedown {
  id            String    @id @default(uuid())
  workId        String
  work          Work      @relation(fields: [workId], references: [id])
  reporterId    String?
  reporterEmail String
  reason        String
  status        String    @default("PENDING") // PENDING | REVIEWED | TAKEN_DOWN | DISMISSED
  adminNote     String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([workId])
  @@index([status])
}

// Feature Flags (F-743)
model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  rolloutPct  Int      @default(100) // 0-100
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// Einzelausleihe ohne Abo (F-321)
model SingleLoanPurchase {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  workId        String
  work          Work     @relation(fields: [workId], references: [id])
  amountCents   Int
  stripePiId    String?  @unique
  status        String   @default("PENDING") // PENDING | COMPLETED | REFUNDED
  loanId        String?  @unique
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([workId])
}

// Extra-Leih-Slots als Add-on (F-350)
model LoanAddon {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  extraLoans   Int       @default(5)
  amountCents  Int
  status       String    @default("PENDING") // PENDING | ACTIVE
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// Multi-Device-Zugriff auf Ausleihen (F-251/F-252)
model LoanDevice {
  id         String   @id @default(uuid())
  loanId     String
  loan       Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  deviceId   String
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([loanId, deviceId])
  @@index([loanId])
}

// Leihe verschenken (F-259)
model LoanGift {
  id          String    @id @default(uuid())
  senderId    String
  sender      User      @relation("SentLoanGifts", fields: [senderId], references: [id])
  recipientId String
  recipient   User      @relation("ReceivedLoanGifts", fields: [recipientId], references: [id])
  workId      String
  work        Work      @relation(fields: [workId], references: [id])
  message     String?
  status      String    @default("PENDING") // PENDING | ACCEPTED | DECLINED
  loanId      String?
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  @@index([senderId])
  @@index([recipientId])
}

// Geplante/reservierte Ausleihe (F-260)
model LoanReservation {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  workId      String
  work        Work     @relation(fields: [workId], references: [id])
  scheduledAt DateTime
  status      String   @default("PENDING") // PENDING | FULFILLED | CANCELLED
  loanId      String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([scheduledAt])
}

model StudentVerification {
  id         String    @id @default(uuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id])
  eduEmail   String
  verifiedAt DateTime?
  expiresAt  DateTime?
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
}

model CookieConsent {
  id             String   @id @default(uuid())
  userId         String?
  sessionId      String?
  analytics      Boolean  @default(false)
  marketing      Boolean  @default(false)
  functional     Boolean  @default(true)
  consentVersion String   @default("1.0")
  ip             String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([userId])
  @@index([sessionId])
}

model ConsentRecord {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  version   String
  granted   Boolean
  ip        String?
  createdAt DateTime @default(now())
  @@index([userId, type])
}

model AbTestAssignment {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  testKey    String
  variant    String
  assignedAt DateTime @default(now())
  @@unique([userId, testKey])
  @@index([testKey])
}

model SubtitleTrack {
  id        String   @id @default(uuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  language  String
  format    String
  url       String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([workId])
}

model Lyrics {
  id        String   @id @default(uuid())
  workId    String   @unique
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  content   String
  format    String   @default("PLAIN")
  language  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkTranslation {
  id          String   @id @default(uuid())
  workId      String
  work        Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  language    String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([workId, language])
  @@index([workId])
}

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([createdAt])
}

model ReviewVote {
  id       String  @id @default(uuid())
  reviewId String
  review   Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId   String
  helpful  Boolean
  @@unique([reviewId, userId])
  @@index([reviewId])
}

model ArtistFaq {
  id        String   @id @default(uuid())
  artistId  String
  artist    User     @relation(fields: [artistId], references: [id])
  question  String
  answer    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([artistId])
}

model Collection {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       CollectionItem[]
  @@index([userId])
}

model CollectionItem {
  id           String     @id @default(uuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  workId       String
  work         Work       @relation(fields: [workId], references: [id])
  sortOrder    Int        @default(0)
  addedAt      DateTime   @default(now())
  @@unique([collectionId, workId])
  @@index([collectionId])
}

model WebhookDelivery {
  id                     String    @id @default(uuid())
  event                  String
  payload                Json
  targetUrl              String
  statusCode             Int?
  attempts               Int       @default(0)
  lastAttemptAt          DateTime?
  succeededAt            DateTime?
  webhookSubscriptionId  String?   // Which subscription triggered this delivery
  createdAt              DateTime  @default(now())
  @@index([event])
  @@index([createdAt])
}

model WebhookSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  url       String
  events    String[] @default([])
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  @@index([userId])
}

// Download-Tokens für zeitlich begrenzte Medien-Downloads (F-852/F-853)
model DownloadToken {
  id        String    @id @default(uuid())
  loanId    String
  loan      Loan      @relation(fields: [loanId], references: [id])
  token     String    @unique @default(uuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([token])
  @@index([loanId])
}

// Rechnungsadresse (F-341)
model BillingAddress {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  vatNumber  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Rabattcodes für Künstler:innen (F-383)
model DiscountCode {
  id              String    @id @default(cuid())
  artistId        String
  artist          User      @relation("ArtistDiscountCodes", fields: [artistId], references: [id])
  code            String    @unique
  discountPercent Int       // 1-100
  maxUses         Int       @default(1)
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([artistId])
  @@index([code])
}

// UTM-Klick-Tracking (F-441)
model UtmClick {
  id        String   @id @default(cuid())
  source    String
  medium    String?
  campaign  String?
  workId    String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([source])
  @@index([workId])
}

// Lese-/Hör-Challenge (F-550)
model ReadingChallenge {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalCount      Int
  completedCount Int      @default(0)
  year           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  deviceName   String?
  browser      String?
  ip           String?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId])
}

model PlaybackPosition {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId          String
  work            Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  positionSeconds Float
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([userId, workId])
  @@index([userId])
}

// Werk-Kategorien (F-146/F-147)
model WorkCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  parentId    String?
  parent      WorkCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    WorkCategory[] @relation("CategoryHierarchy")
  works       WorkCategoryAssignment[]
}

model WorkCategoryAssignment {
  workId      String
  categoryId  String
  work        Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  category    WorkCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([workId, categoryId])
}

// App-Einstellungen (F-372)
model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Site-weite Ankündigungen (F-390)
model Announcement {
  id        String    @id @default(uuid())
  title     String
  body      String
  type      String    @default("INFO") // INFO | WARNING | MAINTENANCE
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdBy String
  createdAt DateTime  @default(now())

  @@index([active])
}
